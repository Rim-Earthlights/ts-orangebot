{
    "name": "ts-orangebot",
    "version": "1.0.0",
    "description": "[TypeScript] Discord Bot for Orange-Server.",
    "author": "Rim Earthlights",
    "license": "MIT",
    "private": true,
    "scripts": {
        "build": "pnpm -r build",
        "clean": "pnpm -r clean",
        "dev": "pnpm --filter @orangebot/bot dev",
        "dev:speak": "pnpm --filter @orangebot/speak dev",
        "lint": "eslint packages",
        "smoke-test": "pnpm --filter @orangebot/bot smoke-test",
        "test": "pnpm -r test",
        "test:integration": "pnpm -r test:integration",
        "test:db:up": "docker compose -f docker-compose.test.yml up -d",
        "test:db:down": "docker compose -f docker-compose.test.yml down -v",
        "tts:up": "systemctl --user start orangebot-voicevox orangebot-coeiroink",
        "tts:down": "systemctl --user stop orangebot-voicevox orangebot-coeiroink",
        "tts:status": "systemctl --user status --no-pager orangebot-voicevox orangebot-coeiroink || true"
    },
    "devDependencies": {
        "@eslint/js": "^9.39.5",
        "@typescript-eslint/eslint-plugin": "^8.71.1",
        "@typescript-eslint/parser": "^8.71.1",
        "eslint": "^9.39.5",
        "eslint-config-prettier": "^10.1.8",
        "license-checker": "^25.0.1"
    }
}
